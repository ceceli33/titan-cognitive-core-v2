    real=[abs(cos(CONS[KEYS[i]][L],CONS[KEYS[j]][L])) for i in range(len(KEYS)) for j in range(i+1,len(KEYS))]
    NULL[str(L)]={"random_abs":float(np.mean(rnd)),"target_abs":float(np.mean(real))}
