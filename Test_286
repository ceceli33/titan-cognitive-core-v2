for c in CN:print(f"{c:10s} L27 | LOO={ATLAS[c]['27']['mean']:+.4f} | P10={ATLAS[c]['27']['p10']:+.4f}")
for L in REPORT:
    RND=torch.randn(len(KEYS),H,device=DEVICE,dtype=torch.float32,generator=g);RND/=RND.norm(dim=1,keepdim=True).clamp_min(EPS)
